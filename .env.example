# Vilona AI v2 - Environment Configuration
# Copy to .env and fill in your values

# Exchange
vilona_EXCHANGE=binance
vilona_EXCHANGE_API_KEY=
vilona_EXCHANGE_API_SECRET=
vilona_EXCHANGE_PASSWORD=
vilona_EXCHANGE_SANDBOX=false
vilona_EXCHANGE_MARKET_TYPE=spot

# Telegram Bot
vilona_TELEGRAM_BOT_TOKEN=
vilona_TELEGRAM_CHAT_IDS=
vilona_TELEGRAM_ADMIN_IDS=

# LLM Provider
vilona_LLM_PROVIDER=openrouter
vilona_LLM_API_KEY=
vilona_LLM_BASE_URL=
vilona_LLM_MODEL=anthropic/claude-3.5-sonnet
vilona_LLM_REASONING_EFFORT=medium

# Trading
vilona_SYMBOLS=BTC/USDT,ETH/USDT
vilona_TIMEFRAMES=1m,5m,15m,1h
vilona_SCAN_INTERVAL=30
vilona_MAX_RISK_PCT=1.0
vilona_MAX_DAILY_LOSS_PCT=3.0
vilona_MAX_DATA_AGE_SECONDS=120
vilona_PAPER_TRADING=true
vilona_AUTONOMY_ENABLED=false
vilona_EMERGENCY_STOP_FILE=vilona.emergency_stop
vilona_HEADLESS=true
vilona_DEBUG=false

# Agent Personas (optional)
vilona_PERSONAS=researcher,trader,risk_manager,judge

# SystemOne/JEV Integration (optional)
vilona_SYSTEMONE_ENABLED=false
vilona_SYSTEMONE_ENDPOINT=
vilona_SYSTEMONE_API_KEY=

# License Server (self-hosted; replaces roxyudeveloper.online)
# Base URL the DESKTOP CLIENT checks licenses against. Point at your hosted
# license_server.py instance, e.g. https://license.yourdomain.com
vilona_LICENSE_SERVER_URL=https://license.vilona.ai
vilona_LICENSE_EA_NAME=VilonaAI
vilona_LICENSE_CONTACT=@oyi77
# --- server-side only (set when running license_server.py) ---
# Admin bearer token for /license/register,/revoke,/status,/list
vilona_LICENSE_ADMIN_TOKEN=
# SQLite path for license records (defaults to data/licenses.db)
vilona_LICENSE_DB=
# Port the standalone license server binds
vilona_LICENSE_PORT=8301

# Multi-tenancy relay (central control plane; desktop binaries phone home outbound)
# --- SERVER side (run on the central relay host, NOT shipped to users) ---
# Secret token the Telegram bot uses to call /relay/* server-to-server.
# No default — relay bot-auth routes deny when unset.
vilona_RELAY_BOT_TOKEN=
# Command lease TTL seconds (a leased-but-uncompleted command returns to pending)
vilona_RELAY_LEASE_SECONDS=120
# --- DESKTOP CLIENT side (each user's machine) ---
# Central relay base URL. MUST be https/TLS in production (put behind a reverse proxy).
vilona_RELAY_URL=
# One-time pairing token shown by the bot's /pair command, pasted into the desktop app.
vilona_RELAY_DEVICE_TOKEN=
vilona_RELAY_POLL_INTERVAL=3
vilona_RELAY_TIMEOUT=10
vilona_RELAY_MAX_BACKOFF=60

# Multi-tenancy relay (central control plane; desktop binaries phone home outbound)
# --- SERVER side (run on the central relay host, NOT shipped to users) ---
# Secret token the Telegram bot uses to call /relay/* server-to-server.
# No default — relay bot-auth routes deny when unset.
vilona_RELAY_BOT_TOKEN=
# Command lease TTL seconds (a leased-but-uncompleted command returns to pending)
vilona_RELAY_LEASE_SECONDS=120
# --- DESKTOP CLIENT side (each user's machine) ---
# Central relay base URL. MUST be https/TLS in production (put behind a reverse proxy).
vilona_RELAY_URL=
# One-time pairing token shown by the bot's /pair command, pasted into the desktop app.
vilona_RELAY_DEVICE_TOKEN=
vilona_RELAY_POLL_INTERVAL=3
vilona_RELAY_TIMEOUT=10
vilona_RELAY_MAX_BACKOFF=60
