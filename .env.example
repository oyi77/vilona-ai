# KingAI v2 - Environment Configuration
# Copy to .env and fill in your values

# Exchange
KINGAI_EXCHANGE=binance
KINGAI_EXCHANGE_API_KEY=
KINGAI_EXCHANGE_API_SECRET=
KINGAI_EXCHANGE_PASSWORD=
KINGAI_EXCHANGE_SANDBOX=false

# Telegram Bot
KINGAI_TELEGRAM_BOT_TOKEN=
KINGAI_TELEGRAM_CHAT_IDS=
KINGAI_TELEGRAM_ADMIN_IDS=

# LLM Provider
KINGAI_LLM_PROVIDER=openrouter
KINGAI_LLM_API_KEY=
KINGAI_LLM_BASE_URL=
KINGAI_LLM_MODEL=anthropic/claude-3.5-sonnet
KINGAI_LLM_REASONING_EFFORT=medium

# Trading
KINGAI_SYMBOLS=BTC/USDT,ETH/USDT
KINGAI_TIMEFRAMES=1m,5m,15m,1h
KINGAI_SCAN_INTERVAL=30
KINGAI_MAX_RISK_PCT=1.0
KINGAI_MAX_DAILY_LOSS_PCT=3.0
KINGAI_PAPER_TRADING=true
KINGAI_HEADLESS=true
KINGAI_DEBUG=false

# Agent Personas (optional)
KINGAI_PERSONAS=researcher,trader,risk_manager,judge

# SystemOne/JEV Integration (optional)
KINGAI_SYSTEMONE_ENABLED=false
KINGAI_SYSTEMONE_ENDPOINT=
KINGAI_SYSTEMONE_API_KEY=
